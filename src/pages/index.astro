const services = [
  {num:'01',title:'Valutazione posturale',description:'Un primo incontro per osservare la postura, ascoltare le tue esigenze e individuare un percorso adatto a te.',icon:'◎'},
  {num:'02',title:'Educazione al movimento',description:'Indicazioni e consapevolezza per muoverti meglio nella quotidianità, rispettando i tuoi tempi.',icon:'↗'},
  {num:'03',title:'Percorso personalizzato',description:'Un accompagnamento costruito intorno ai tuoi obiettivi e alle necessità emerse durante la valutazione.',icon:'✳'}
